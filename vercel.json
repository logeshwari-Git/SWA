{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "swa_backend": {
      "root": "SWA_BACKEND",
      "framework": "express"
    },
    "swa_frontend": {
      "root": "SWA_FRONTEND",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "swa_backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "swa_frontend"
      }
    }
  ]
}